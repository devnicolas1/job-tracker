{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal career database, resume vault and AI-curated job pipeline, operated by Claude Code over MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mcp": "tsx src/mcp/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "demo": "JOB_TRACKER_DATA_DIR=.demo-data tsx scripts/seed-demo.ts && JOB_TRACKER_DATA_DIR=.demo-data next dev --port 3001"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-pdf/renderer": "^4.9.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.62.0",
    "mupdf": "^1.28.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
